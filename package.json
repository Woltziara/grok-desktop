{
  "name": "grok-desktop",
  "version": "1.4.2-unified.1",
  "description": "Desktop GUI for the Grok Build coding agent (Electron + ACP)",
  "main": "electron/main.mjs",
  "type": "module",
  "author": "Karman de Lange; Oscar Woltz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Woltziara/grok-desktop.git"
  },
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build && node scripts/write-build-identity.mjs",
    "start": "electron .",
    "preview": "npm run build && electron .",
    "pack": "npm run check && npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "test": "node --experimental-strip-types --test test/**/*.test.mjs",
    "test:acp": "node --test test/acp-rpc.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test:preview": "node scripts/test-preview.mjs",
    "test:sidebar": "node scripts/test-sidebar.mjs",
    "test:delivery": "node scripts/test-delivery.mjs",
    "test:knowledge-transfer": "node scripts/test-knowledge-transfer.mjs",
    "test:continuation": "node scripts/test-continuation.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "electron-updater": "^6.6.2",
    "fuse.js": "^7.5.0",
    "playwright-core": "^1.63.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "wait-on": "^8.0.3",
    "plist": "^3.1.0"
  },
  "build": {
    "appId": "com.karman.grok-desktop",
    "productName": "Grok Desktop",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/playwright-core/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Woltziara",
      "repo": "grok-desktop"
    },
    "afterPack": "./scripts/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GrokDesktop-${version}-Windows-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "artifactName": "GrokDesktop-${version}-Mac-${arch}.${ext}"
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "artifactName": "GrokDesktop-${version}-Linux-x64.${ext}"
    },
    "electronDist": "node_modules/electron/dist"
  }
}
