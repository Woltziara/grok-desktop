[{"path":"src/vite-env.d.ts","before":"4c4b2e5237be61b3618fd89e1253a37e4ad44f67","after":"a8e814ea2a2c5e172a768d43cbaaaed8106de873","edits":[{"start":477,"delete":1,"text":"  source?: { type?: string; pointer?: string; quote?: string; sessionId?: string; inboxId?: string };\n"},{"start":691,"delete":0,"text":"      createWorkingKnowledgeObject: (title:string) => Promise<{id:string;title:string}>;\n      exportWorkingKnowledge: (objectId:string) => Promise<{ok?:boolean;cancelled?:boolean;path?:string;head?:string}>;\n      importWorkingKnowledge: () => Promise<{cancelled?:boolean;plan?:WorkingKnowledgeTransferPlan}>;\n      listWorkingKnowledgeTransfers: () => Promise<Array<{token:string;objectId:string;title:string;sourceMachine:string}>>;\n      previewWorkingKnowledgeTransfer: (token:string) => Promise<WorkingKnowledgeTransferPlan>;\n      acceptWorkingKnowledgeTransfer: (input:{token:string;localHead:string|null;choice:'continue'|'keep-local'|'use-incoming'}) => Promise<{ok:boolean;changed:boolean;objectId:string;backup?:string|null;head?:string}>;\n"},{"start":958,"delete":0,"text":"\nexport type WorkingKnowledgeTransferPlan = {token:string;objectId:string;title:string;localTitle:string|null;sourceMachine:string;kind:'new'|'equal'|'local-ahead'|'incoming-ahead'|'conflict';localHead:string|null;incomingHead:string;changes:Array<{id:string;local:WorkingKnowledgeItem|null;incoming:WorkingKnowledgeItem|null}>;localPending:number;incomingPending:number;exportedAt:string};\n"}]},{"path":"test/electron/knowledge-transfer-smoke.mjs","before":null,"after":"9dbf547306609930912ac433c1231cb04094e0aa","edits":[{"start":0,"delete":0,"text":"// Native file-picking is replaced by deterministic choices; no fake transfer handlers.\nimport {app,BrowserWindow,ipcMain} from 'electron';\nimport fs from 'node:fs';import path from 'node:path';import os from 'node:os';import http from 'node:http';import assert from 'node:assert/strict';import {fileURLToPath} from 'node:url';import {build} from 'esbuild';\nimport {ensureStore,ensureObject,writeRecord,readCurrent} from '../../shared/working-knowledge/store.mjs';\nimport {uiCorrect} from '../../shared/working-knowledge/updates.mjs';\nimport {exportWorkingObject,stageWorkingBundle,acceptWorkingBundle,listPendingWorkingBundles} from '../../shared/working-knowledge/sync.mjs';\nimport {registerKnowledgeTransferIpc} from '../../electron/knowledge-transfer-ipc.mjs';\nconst root=fileURLToPath(new URL('../../',import.meta.url)),tmp=fs.mkdtempSync(path.join(os.tmpdir(),'knowledge-electron-'));\nfs.mkdirSync(path.join(tmp,'profile'));app.setPath('userData',path.join(tmp,'profile'));app.setPath('sessionData',path.join(tmp,'profile'));\nconst {enablePreviewRemoteDebugging}=await import('../../electron/preview-cdp.mjs');enablePreviewRemoteDebugging();\nconst a=path.join(tmp,'primary'),b=path.join(tmp,'companion');ensureStore(a);ensureStore(b);ensureObject(a,'sample',{title:'合成测试，不是业务原件'});writeRecord(a,{id:'decision',objectId:'sample',kind:'decision',text:'基线条件',epistemic:'user_said',source:{type:'user',sessionId:'A',quote:'基线条件'}});\nconst p=stageWorkingBundle(b,exportWorkingObject(a,'sample'));acceptWorkingBundle(b,{...p,choice:'continue'});\nuiCorrect(a,{objectId:'sample',id:'decision',text:'本机保留条件',sessionId:'A'});uiCorrect(b,{objectId:'sample',id:'decision',text:'另一机器条件',sessionId:'B'});\nconst incoming=path.join(tmp,'incoming.json'),outgoing=path.join(tmp,'outgoing.json');fs.writeFileSync(incoming,JSON.stringify(exportWorkingObject(b,'sample')));\nlet win,server;\nregisterKnowledgeTransferIpc(ipcMain,{root:()=>a,windowFromEvent:e=>BrowserWindow.fromWebContents(e.sender),dialog:{showOpenDialog:async()=>({filePaths:[incoming]}),showSaveDialog:async()=>({filePath:outgoing})}});\napp.whenReady().then(async()=>{\n  try{\n    const bundle=path.join(tmp,'ui.js');await build({entryPoints:[path.join(root,'test/ui/knowledge-transfer-harness.tsx')],outfile:bundle,bundle:true,format:'esm',platform:'browser',jsx:'automatic',define:{'process.env.NODE_ENV':'\"test\"'}});\n    server=http.createServer((req,res)=>{res.setHeader('content-type',req.url==='/ui.js'?'text/javascript':'text/html');res.end(req.url==='/ui.js'?fs.readFileSync(bundle):'<style>body{margin:20px}details{max-height:180px;overflow:auto}button{margin:5px}</style><div id=\"root\"></div><script type=\"module\" src=\"/ui.js\"></script>');});await new Promise(r=>server.listen(0,'127.0.0.1',r));\n    win=new BrowserWindow({width:1100,height:1100,webPreferences:{preload:path.join(root,'electron/preload.cjs'),contextIsolation:true,nodeIntegration:false,sandbox:false}});await win.loadURL(`http://127.0.0.1:${server.address().port}`);\n    const {connectPreviewPlaywright,listPlaywrightPages}=await import('../../electron/preview-playwright.mjs');await connectPreviewPlaywright();const page=listPlaywrightPages().find(p=>p.url().startsWith('http://127.0.0.1:'));\n    await page.getByRole('button',{name:'导出当前这件事',exact:true}).click();await page.getByRole('status').filter({hasText:'已导出'}).waitFor();assert.equal(JSON.parse(fs.readFileSync(outgoing)).objectId,'sample');\n    await page.getByRole('button',{name:'接入另一台带来的版本',exact:true}).click();await page.getByRole('heading',{name:/两边都有独立修改/}).waitFor();\n    const pending=listPendingWorkingBundles(a);assert.equal(pending.length,1);assert.ok(readCurrent(a,'sample').items.some(r=>r.text==='本机保留条件'));\n    await page.reload();await page.getByRole('button',{name:/合成测试.*查看/}).click();await page.getByRole('heading',{name:/两边都有独立修改/}).waitFor();\n    for(const summary of await page.locator('summary').all())await summary.click();\n    assert.match(await page.locator('body').textContent(),/本机保留条件/);assert.match(await page.locator('body').textContent(),/另一机器条件/);\n    await page.getByRole('button',{name:'这一轮采用带来的版',exact:true}).click();await page.getByRole('status').filter({hasText:'原件保存在'}).waitFor();\n    assert.ok(readCurrent(a,'sample').items.some(r=>r.text==='另一机器条件'));assert.equal(listPendingWorkingBundles(a).length,0);\n    assert.ok(fs.readdirSync(path.join(a,'transfer-backups')).length>0);\n    const newObject=await page.evaluate(()=>window.grokDesktop.createWorkingKnowledgeObject('创建的合成对象'));assert.match(newObject.id,/^object-/);assert.equal(newObject.title,'创建的合成对象');\n    console.log(JSON.stringify({ok:true,electron:process.versions.electron,checks:['production UI exports actual object bundle through preload/main','incoming conflict is staged, never silently applied','pending conflict survives renderer reload','both source versions displayed','explicit incoming choice saves original backup and reads back chosen current','actual object creation IPC']}));\n  }catch(error){console.error(error.stack);process.exitCode=1;}finally{win?.destroy();server?.close();fs.rmSync(tmp,{recursive:true,force:true});app.exit(process.exitCode||0);}\n}).catch(error=>{console.error(error);app.exit(1);});\n"}]},{"path":"test/ui/knowledge-transfer-harness.tsx","before":null,"after":"fcb3ecacdb147e01f6050993259d80f63fea5201","edits":[{"start":0,"delete":0,"text":"// Only the shell is a fixture; the transfer UI and IPC are production modules.\nimport React from 'react';\nimport {createRoot} from 'react-dom/client';\nimport {WorkingKnowledgeTransfer} from '../../src/components/WorkingKnowledgeTransfer';\ncreateRoot(document.getElementById('root')!).render(<WorkingKnowledgeTransfer objectId=\"sample\"/>);\n"}]},{"path":"test/working-knowledge-sync.test.mjs","before":null,"after":"f806785f32fa080fdf7304b9f47d0b71f935b731","edits":[{"start":0,"delete":0,"text":"import fs from 'node:fs';\nimport os from 'node:os';\nimport path from 'node:path';\nimport assert from 'node:assert/strict';\nimport {test} from 'node:test';\nimport {ensureStore,ensureObject,writeRecord,readCurrent,listObjects,appendInbox,markInbox,writeConfig,bindSession,listInbox} from '../shared/working-knowledge/store.mjs';\nimport {uiCorrect,uiWithdraw} from '../shared/working-knowledge/updates.mjs';\nimport {exportWorkingObject,stageWorkingBundle,previewWorkingBundle,acceptWorkingBundle,listPendingWorkingBundles,validateWorkingBundle} from '../shared/working-knowledge/sync.mjs';\nfunction setup(t){const root=fs.mkdtempSync(path.join(os.tmpdir(),'wk-transfer-'));t.after(()=>{delete process.env.GROK_DESKTOP_WK_ROOT;fs.rmSync(root,{recursive:true,force:true});});const a=path.join(root,'a'),b=path.join(root,'b');ensureStore(a);ensureStore(b);ensureObject(a,'sample',{title:'合成示例'});writeRecord(a,{id:'baseline',objectId:'sample',kind:'decision',text:'同意两周试用',epistemic:'user_said',source:{type:'user',sessionId:'A',quote:'同意两周试用'}});return {a,b,root};}\nfunction accept(root,bundle){const p=stageWorkingBundle(root,bundle);return acceptWorkingBundle(root,{token:p.token,localHead:p.localHead,choice:'continue'});}\ntest('portable object bundle is explicit, hash-checked and excludes config, credentials, bindings and unknown files',t=>{const {a,b}=setup(t);for(const name of ['auth.json','mcp_credentials.json','config.toml'])fs.writeFileSync(path.join(a,'objects/sample',name),'credential-fixture-not-exported');writeConfig(a,{probeArmed:true,currentObjectId:'sample'});const bundle=exportWorkingObject(a,'sample',{machine:'primary'});assert.doesNotMatch(JSON.stringify(bundle),/credential-fixture|probeArmed|config.toml/);accept(b,bundle);assert.equal(readCurrent(b,'sample').items[0].source.sessionId,'A');assert.equal(listObjects(b)[0].title,'合成示例');assert.deepEqual(exportWorkingObject(b,'sample').data,bundle.data);assert.equal(exportWorkingObject(b,'sample').head,bundle.head);});\ntest('two physical stores diverge: concurrency cannot be settled by timestamps and both originals remain',t=>{const {a,b}=setup(t);accept(b,exportWorkingObject(a,'sample'));uiCorrect(a,{objectId:'sample',id:'baseline',text:'本机改为一周',sessionId:'A'});uiCorrect(b,{objectId:'sample',id:'baseline',text:'僚机改为三周',sessionId:'B'});fs.utimesSync(path.join(a,'objects/sample/current.json'),new Date(0),new Date(0));const original=fs.readFileSync(path.join(a,'objects/sample/records.jsonl'),'utf8');const p=stageWorkingBundle(a,exportWorkingObject(b,'sample'));assert.equal(p.kind,'conflict');assert.throws(()=>acceptWorkingBundle(a,{...p,choice:'continue'}),/独立更新/);const result=acceptWorkingBundle(a,{...p,choice:'keep-local'});assert.equal(fs.readFileSync(path.join(result.backup,'records.jsonl'),'utf8'),original);assert.ok(readCurrent(a,'sample').items.some(r=>r.text==='本机改为一周'));const back=stageWorkingBundle(b,exportWorkingObject(a,'sample'));assert.equal(back.kind,'incoming-ahead');acceptWorkingBundle(b,{...back,choice:'continue'});assert.deepEqual(readCurrent(a,'sample'),readCurrent(b,'sample'));});\ntest('incoming conflict choice retains local backup; tombstone cannot revive from an older bundle',t=>{const {a,b}=setup(t);const old=exportWorkingObject(a,'sample');accept(b,old);uiCorrect(a,{objectId:'sample',id:'baseline',text:'本机新想法'});uiWithdraw(b,{objectId:'sample',id:'baseline'});const p=stageWorkingBundle(a,exportWorkingObject(b,'sample'));assert.equal(p.kind,'conflict');const r=acceptWorkingBundle(a,{...p,choice:'use-incoming'});assert.ok(fs.existsSync(r.backup));assert.ok(!readCurrent(a,'sample').items.some(r=>r.id==='baseline'));const earlier=stageWorkingBundle(a,old);assert.equal(earlier.kind,'local-ahead');assert.throws(()=>acceptWorkingBundle(a,{...earlier,choice:'use-incoming'}),/不能回退/);});\ntest('a correction after preview invalidates acceptance, including identical integer versions on independent machines',t=>{const {a,b}=setup(t);accept(b,exportWorkingObject(a,'sample'));uiCorrect(b,{objectId:'sample',id:'baseline',text:'来自僚机'});const p=stageWorkingBundle(a,exportWorkingObject(b,'sample'));writeRecord(a,{objectId:'sample',kind:'unknown',text:'本机刚补的问题'});assert.throws(()=>acceptWorkingBundle(a,{...p,choice:'continue'}),/预览后/);assert.ok(listPendingWorkingBundles(a).some(r=>r.token===p.token));});\ntest('interruption between original backup and installation is recovered by ordinary object listing in a fresh module consumer',t=>{const {a,b}=setup(t);accept(b,exportWorkingObject(a,'sample'));uiCorrect(b,{objectId:'sample',id:'baseline',text:'后继版本'});fs.writeFileSync(path.join(a,'objects/sample/user-original.txt'),'keep locally');const p=stageWorkingBundle(a,exportWorkingObject(b,'sample'));assert.throws(()=>acceptWorkingBundle(a,{...p,choice:'continue'},{afterBackup(){throw Error('simulated power loss');}}),/power loss/);assert.ok(!fs.existsSync(path.join(a,'objects/sample')));assert.equal(listObjects(a)[0].id,'sample');assert.equal(fs.readFileSync(path.join(a,'objects/sample/user-original.txt'),'utf8'),'keep locally');assert.ok(readCurrent(a,'sample').items.some(r=>r.text==='后继版本'));assert.equal(previewWorkingBundle(a,p.token).kind,'equal');});\ntest('tampered payload, corrupted history, symlink files, and arbitrary file names are not silently accepted',t=>{const {a,b,root}=setup(t);const bundle=exportWorkingObject(a,'sample');bundle.data.current.items[0].text='tampered';assert.throws(()=>stageWorkingBundle(b,bundle),/校验/);fs.writeFileSync(path.join(a,'objects/sample/records.jsonl'),'{bad');assert.throws(()=>exportWorkingObject(a,'sample'));fs.unlinkSync(path.join(a,'objects/sample/records.jsonl'));fs.writeFileSync(path.join(root,'private.txt'),'[]');fs.symlinkSync(path.join(root,'private.txt'),path.join(a,'objects/sample/records.jsonl'));assert.throws(()=>exportWorkingObject(a,'sample'),/链接/);assert.equal(listObjects(b).length,0);});\ntest('inbox original identity and pending state move with the object, not host credentials',t=>{const {a,b}=setup(t);const one=appendInbox(a,{objectId:'sample',sessionId:'S1',cwd:'/one',text:'相同原话',source:'user'}),two=appendInbox(a,{objectId:'sample',sessionId:'S2',cwd:'/two',text:'相同原话',source:'user'});markInbox(a,'sample',one.id,{status:'processed'});const bundle=exportWorkingObject(a,'sample');const p=stageWorkingBundle(b,bundle);assert.equal(p.incomingPending,1);acceptWorkingBundle(b,{...p,choice:'continue'});assert.equal(listInbox(b,'sample','pending')[0].id,two.id);assert.equal(listInbox(b,'sample','pending')[0].sessionId,'S2');});\ntest('a real outgoing turn prepared before import cannot commit after another device changes the object',async t=>{const {a,b}=setup(t);writeConfig(a,{currentObjectId:'sample'});bindSession(a,{sessionId:'session-test',objectId:'sample',source:'user'});process.env.GROK_DESKTOP_WK_ROOT=a;const {wrapOutgoingPrompt,consumeTurnOutput}=await import('../electron/working-knowledge.mjs');const turn=wrapOutgoingPrompt({sessionId:'session-test',text:'旧回合',cwd:'/synthetic'});accept(b,exportWorkingObject(a,'sample'));uiCorrect(b,{objectId:'sample',id:'baseline',text:'更新的认识'});accept(a,exportWorkingObject(b,'sample'));const result=consumeTurnOutput({...turn,assistantText:'无论输出什么',sessionId:'session-test',objectId:'sample'});assert.equal(result.reason,'object-transferred');});\n"}]}]