[{"path":"docs/PROGRESS-20260914.md","before":"5f028e6e27aebce8f7f499c400b6f11f3f8aae84","after":"a9948298660bdd41edffca1d22407f328864587d","edits":[{"start":30,"delete":0,"text":"## 单元四：发送箱与草稿接续\n\n- 单元三实际源码提交：`7e121f6e978087457c0ed093cebe82815d3c210a`。本单元基于该产品源码继续。\n- 按原生会话ID持久化待发送内容和完整编码图片。入箱写入成功后才接受发送；失败和进程重启时未确认结果保留供核对，不自动重放。队列增删改序和重试均走同一主进程存储。\n- 继续使用唯一 ACP prompt/interject 路径；后台A的FIFO不跟随当前显示B，迟到完成不能释放B的忙碌状态。主进程结算事件让重载界面能恢复尚未处理的队列。\n- 附件导入明确携带原生会话ID。准备中切换会话不会发送到新对话；准备完成后存回原会话草稿，包括已经换项目的原会话。接受发送只清理提交快照，保留后来输入的文字、引用和附件。\n- 配置解析/重复key错误与登录过期分开，展示可执行的恢复说明；ANSI及重复日志去除。\n- `npm run check`：类型检查、736/736测试通过。`npm run build`成功。`npm run test:delivery`：真实Electron+Playwright运行正式Composer、usePromptDelivery和preload，执行从实际main源码抽取的IPC handlers与真实磁盘发送箱；验证异步准备切会话、A队列/B忙碌、取消和界面重载恢复、迟到附件归属。模型一侧是明确隔离的测试peer，不冒充真实Grok运行。\n- 当前Linux子进程和磁盘验证不等于macOS/用户账号验收。强制杀进程发生于系统尚未接受附件字节之前，不能凭空恢复未落盘的字节；正常提交与已保存草稿由本单元保护。\n\n"}]},{"path":"electron/main.mjs","before":"38f917e2925810189f563220bc63d9bd7296044b","after":"7cfd57de994098c5cb92432750a598d4a95ea1d2","edits":[{"start":0,"delete":0,"text":"import { createSessionOutbox } from \"./session-outbox.mjs\";\n"},{"start":845,"delete":0,"text":"let sessionOutbox;\nfunction outbox() { return sessionOutbox ||= createSessionOutbox(path.join(app.getPath(\"userData\"), \"outbox\")); }\nfunction notifyOutbox(ws, sessionId, settled = false, cwd = \"\") { send(ws, \"agent:outbox-changed\", { sessionId, settled, cwd }); }\n\n"},{"start":1308,"delete":0,"text":"      if (outbox().isActive(payload.sessionId)) throw new Error(\"正在保存发送结果，请稍后再移动这段对话。\");\n"},{"start":1408,"delete":0,"text":"  ipcMain.handle(\"agent:outbox-list\", (e, sessionId) => {\n    const ws = sessionFromEvent(e);\n    if (!ws) throw new Error(\"No conversation window\");\n    return outbox().read(sessionId);\n  });\n  ipcMain.handle(\"agent:outbox-mutate\", (e, { sessionId, action, data }) => {\n    const ws = sessionFromEvent(e);\n    const agent = agentForSession(ws, sessionId);\n    if (!agent?.ready) throw new Error(\"请先重新连接这段对话，再处理待发送内容。\");\n    const rows = outbox().mutate(sessionId, action, { ...data, cwd: agent.cwd });\n    notifyOutbox(ws, sessionId);\n    return rows;\n  });\n"},{"start":1410,"delete":1,"text":"    async (e, { text, images = [], imageQuality = \"compact\", origin = \"user\", sessionId, deliveryId }) => {\n"},{"start":1415,"delete":4,"text":"        const deliver = row => agent.prompt(row.text, {\n          images: row.images, imageQuality: row.imageQuality,\n          origin: row.origin === \"followup\" ? \"followup\" : \"user\",\n"},{"start":1420,"delete":0,"text":"        return deliveryId ? await outbox().run(agent.sessionId, deliveryId, deliver)\n          : await deliver({ text, images, imageQuality, origin });\n"},{"start":1423,"delete":1,"text":"      } finally { if (deliveryId) notifyOutbox(sessionFromEvent(e), agent.sessionId, true, agent.cwd); }\n"},{"start":1431,"delete":1,"text":"      { text, images = [], imageQuality = \"compact\", interjectionId, sessionId, deliveryId } = {},\n"},{"start":1437,"delete":5,"text":"        const deliver = row => agent.interject(row.text, { images: row.images, imageQuality: row.imageQuality, interjectionId: deliveryId || interjectionId });\n        return deliveryId ? await outbox().run(agent.sessionId, deliveryId, deliver)\n          : await deliver({ text, images, imageQuality });\n"},{"start":1444,"delete":1,"text":"      } finally { if (deliveryId) notifyOutbox(sessionFromEvent(e), agent.sessionId, true, agent.cwd); }\n"},{"start":2070,"delete":1,"text":"  ipcMain.handle(\"attachments:import\", async (e, sourcePath, sessionId) => {\n"},{"start":2072,"delete":0,"text":"    const agent = agentForSession(ws, sessionId);\n"},{"start":2073,"delete":2,"text":"      cwd: agent?.cwd,\n      sessionId: agent?.sessionId,\n"}]},{"path":"electron/preload.cjs","before":"c4d37332be29da680428f8330afd25408ac3fed4","after":"bf4dbd7ad9aacba5711c6e138a6aba684775f33d","edits":[{"start":34,"delete":0,"text":"  listOutbox: (sessionId) => ipcRenderer.invoke(\"agent:outbox-list\", sessionId),\n  mutateOutbox: (sessionId, action, data) => ipcRenderer.invoke(\"agent:outbox-mutate\", { sessionId, action, data }),\n"},{"start":38,"delete":0,"text":"      deliveryId: opts?.deliveryId,\n"},{"start":49,"delete":0,"text":"      deliveryId: opts?.deliveryId,\n"},{"start":150,"delete":1,"text":"  importAttachment: (path, sessionId) => ipcRenderer.invoke(\"attachments:import\", path, sessionId),\n"},{"start":193,"delete":0,"text":"      \"agent:outbox-changed\",\n"}]}]